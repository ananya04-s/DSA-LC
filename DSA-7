"""
Problem: Count and Say
LeetCode #38

The count-and-say sequence is generated by repeatedly
describing the previous sequence.

Example:
1
11      -> one 1
21      -> two 1s
1211    -> one 2, one 1
111221  -> one 1, one 2, two 1s

Approach:
Simulation

1. Start with "1".
2. For each iteration, read consecutive identical characters.
3. Count how many times each character appears consecutively.
4. Append the count followed by the character.
5. Repeat until reaching the nth sequence.

Time Complexity: O(n * m)
Space Complexity: O(m)

Where m is the length of the generated sequence.
"""


class Solution:
    def countAndSay(self, n: int) -> str:
        res = "1"

        # Generate the sequence n - 1 times
        for _ in range(n - 1):
            temp = ""
            i = 0

            while i < len(res):
                count = 1

                # Count consecutive identical characters
                while (
                    i + 1 < len(res)
                    and res[i] == res[i + 1]
                ):
                    i += 1
                    count += 1

                # Add count followed by the character
                temp += str(count) + res[i]

                i += 1

            res = temp

        return res
