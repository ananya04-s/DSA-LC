"""
Problem: Divide Two Integers
LeetCode #29

Given two integers dividend and divisor, divide two integers
without using multiplication, division, or modulo operators.

The result should be truncated toward zero.

Approach:
Bit Manipulation

1. Handle special edge cases.
2. Determine whether the result should be positive or negative.
3. Convert both numbers to positive values.
4. Use left shifts to find the largest multiple of the divisor
   that can be subtracted from the dividend.
5. Add the corresponding quotient value using bit shifts.
6. Apply the correct sign to the result.
7. Clamp the result within the 32-bit signed integer range.

Time Complexity: O(log² n)
Space Complexity: O(1)
"""


class Solution:
    def divide(self, dividend: int, divisor: int) -> int:
        # Edge case
        if dividend == divisor:
            return 1

        # Handle 32-bit integer overflow
        if dividend == -2**31 and divisor == -1:
            return (2**31) - 1

        # Dividing by 1
        if divisor == 1:
            return dividend

        # Determine the sign of the result
        sign = -1 if (dividend < 0) ^ (divisor < 0) else 1

        # Work with positive values
        n = abs(dividend)
        d = abs(divisor)

        answer = 0

        while n >= d:
            power = 0

            # Find the largest multiple of divisor
            while n >= (d << power):
                power += 1

            power -= 1

            # Subtract the largest possible multiple
            n -= d << power

            # Add the corresponding quotient value
            answer += 1 << power

        # Apply sign
        result = sign * answer

        # Clamp to 32-bit signed integer range
        return min(max(result, -2**31), 2**31 - 1)
