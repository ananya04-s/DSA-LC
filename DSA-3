"""
Problem: Longest Palindromic Substring
LeetCode #5

Given a string s, return the longest palindromic substring in s.

Approach:
Brute Force

1. Check every possible substring.
2. For each substring, check whether it is a palindrome.
3. A string is a palindrome if it reads the same forwards and backwards.
4. Keep track of the longest palindrome found.

Time Complexity: O(n³)
Space Complexity: O(n)
"""


class Solution:
    def longestPalindrome(self, s: str) -> str:
        if len(s) <= 1:
            return s

        max_len = 1
        max_str = s[0]

        for i in range(len(s) - 1):
            for j in range(i + 1, len(s)):
                
                substring = s[i:j + 1]

                if (
                    j - i + 1 > max_len
                    and substring == substring[::-1]
                ):
                    max_len = j - i + 1
                    max_str = substring

        return max_str
